/* Aurum LIMS theme. Gold accent (#9a7b1c) on neutral greys. */

QWidget {
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 10pt;
    color: #1f2933;
}

QMainWindow, QDialog, #Content {
    background: #f4f5f7;
}

/* ---------- Sidebar ---------- */
#Sidebar {
    background: #1c2430;
}
#Sidebar QLabel {
    color: #cfd6df;
}
#SidebarTitle {
    color: #ffffff;
    font-size: 13pt;
    font-weight: 600;
}
#SidebarSubtitle {
    color: #8b98a8;
    font-size: 8.5pt;
}
#NavList {
    background: transparent;
    border: none;
    outline: none;
}
#NavList QScrollBar:vertical {
    background: #1c2430;
    width: 8px;
    margin: 0;
}
#NavList QScrollBar::handle:vertical {
    background: #3a4656;
    border-radius: 4px;
    min-height: 24px;
}
#NavList QScrollBar::add-line:vertical, #NavList QScrollBar::sub-line:vertical {
    height: 0;
}
#NavList QScrollBar::add-page:vertical, #NavList QScrollBar::sub-page:vertical {
    background: transparent;
}
#NavList::item {
    color: #cfd6df;
    padding: 9px 14px;
    border-left: 3px solid transparent;
}
#NavList::item:hover {
    background: #263140;
}
#NavList::item:selected {
    background: #2b3646;
    color: #ffffff;
    border-left: 3px solid #c9a227;
}
/* Grouped navigation: headings in the sidebar, pages in a flyout menu */
#NavGroup {
    background: transparent;
    color: #cfd6df;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0;
    padding: 10px 30px 10px 14px;
    text-align: left;
    font-size: 10pt;
}
#NavGroup:hover {
    background: #263140;
}
#NavGroup:checked {
    background: #2b3646;
    color: #ffffff;
    border-left: 3px solid #c9a227;
    font-weight: 600;
}
#NavArrow {
    color: #8b98a8;
    font-size: 13pt;
    background: transparent;
}
#Sidebar #NavCurrent {
    color: #c9a227;
    font-size: 8.5pt;
    padding: 0 0 6px 20px;
}
#Flyout {
    background: #ffffff;
    border: 1px solid #d5dae1;
    border-left: 3px solid #c9a227;
    border-radius: 6px;
}
#FlyoutTitle {
    color: #6b7785;
    font-size: 8.5pt;
    font-weight: 600;
    padding: 2px 10px 6px 10px;
    text-transform: uppercase;
}
#FlyoutItem {
    background: transparent;
    color: #1f2933;
    border: none;
    border-radius: 4px;
    padding: 8px 12px;
    text-align: left;
    font-size: 10pt;
}
#FlyoutItem:hover {
    background: #f3ecd6;
}
#FlyoutItem:checked {
    background: #f3ecd6;
    color: #7a5f10;
    font-weight: 600;
}
#SidebarUser {
    color: #ffffff;
    font-weight: 600;
}
#SidebarRole {
    color: #c9a227;
    font-size: 8.5pt;
}

/* ---------- Header & cards ---------- */
#Header {
    background: #ffffff;
    border-bottom: 1px solid #e3e6ea;
}
#PageTitle {
    font-size: 15pt;
    font-weight: 600;
}
#Card {
    background: #ffffff;
    border: 1px solid #e3e6ea;
    border-radius: 8px;
}
#CardTitle {
    font-size: 11pt;
    font-weight: 600;
}
#CardValue {
    font-size: 20pt;
    font-weight: 600;
    color: #9a7b1c;
}
#Muted, QLabel[muted="true"] {
    color: #6b7785;
}
#ErrorLabel {
    color: #b42318;
}
#SuccessLabel {
    color: #067647;
}
#UpdateBanner {
    background: #fff7e0;
    border-bottom: 1px solid #e9d38a;
}
#Banner {
    background: #fff7e0;
    border: 1px solid #e9d38a;
    border-radius: 6px;
    padding: 8px 10px;
}

/* ---------- Login / first-run ---------- */
#LoginCard {
    background: #ffffff;
    border: 1px solid #e3e6ea;
    border-radius: 10px;
}
#LoginTitle {
    font-size: 16pt;
    font-weight: 600;
}

/* ---------- Inputs ---------- */
/* Spin boxes and date edits keep the Fusion look so their arrow buttons draw correctly. */
QLineEdit, QComboBox, QPlainTextEdit, QTextEdit {
    background: #ffffff;
    border: 1px solid #cdd3da;
    border-radius: 5px;
    padding: 5px 7px;
    selection-background-color: #c9a227;
}
QSpinBox, QDateEdit {
    min-height: 24px;
}
QLineEdit:focus, QComboBox:focus, QPlainTextEdit:focus {
    border: 1px solid #9a7b1c;
}
QLineEdit:disabled, QComboBox:disabled {
    background: #f0f1f3;
    color: #8b98a8;
}

/* ---------- Buttons ---------- */
QPushButton {
    background: #ffffff;
    border: 1px solid #cdd3da;
    border-radius: 5px;
    padding: 6px 14px;
}
QPushButton:hover {
    background: #f0f1f3;
}
QPushButton:pressed {
    background: #e3e6ea;
}
QPushButton:disabled {
    color: #a0aab5;
    background: #f7f8f9;
}
QPushButton[primary="true"] {
    background: #9a7b1c;
    border: 1px solid #8a6d15;
    color: #ffffff;
    font-weight: 600;
}
QPushButton[primary="true"]:hover {
    background: #b08d25;
}
QPushButton[primary="true"]:disabled {
    background: #d8caa0;
    border-color: #d8caa0;
}
QPushButton[danger="true"] {
    color: #b42318;
}

/* ---------- Tables (spreadsheet style: every cell outlined) ---------- */
QTreeWidget {
    background: #ffffff;
    border: 1px solid #b8c0ca;
    alternate-background-color: #f7f9fb;
    selection-background-color: #f3e7c0;
    selection-color: #1f2933;
}
QTreeWidget::item {
    padding: 4px 2px;
    border-right: 1px solid #d5dae1;
    border-bottom: 1px solid #d5dae1;
}
QTableWidget, QTableView {
    background: #ffffff;
    border: 1px solid #b8c0ca;
    gridline-color: #d5dae1;
    selection-background-color: #f3e7c0;
    selection-color: #1f2933;
    alternate-background-color: #f7f9fb;
}
QHeaderView::section {
    background: #e9edf2;
    border: none;
    border-right: 1px solid #c3cad3;
    border-bottom: 1px solid #b8c0ca;
    padding: 6px 8px;
    font-weight: 600;
    color: #374151;
}
QTableCornerButton::section {
    background: #e9edf2;
    border: none;
    border-right: 1px solid #c3cad3;
    border-bottom: 1px solid #b8c0ca;
}
